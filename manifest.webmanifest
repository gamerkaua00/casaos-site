{
  "name": "CasaOS",
  "short_name": "CasaOS",
  "description": "Sua nuvem pessoal: arquivos e fotos no disco de casa.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e8edf3",
  "theme_color": "#2748e8",
  "categories": ["productivity", "photo"],
  "icons": [
    { "src": "icon/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Fotos", "short_name": "Fotos", "url": "./?view=photos", "icons": [{ "src": "icon/icon-192.png", "sizes": "192x192" }] },
    { "name": "Meus arquivos", "short_name": "Arquivos", "url": "./?view=files", "icons": [{ "src": "icon/icon-192.png", "sizes": "192x192" }] },
    { "name": "Lixeira", "short_name": "Lixeira", "url": "./?view=trash", "icons": [{ "src": "icon/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "files", "accept": ["image/*", "video/*", "audio/*", "application/*", "text/*", ".heic", ".heif"] }]
    }
  }
}
